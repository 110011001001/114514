local function HttpGet(url)
    local success, result = pcall(function()
        return game:HttpGet(url .. "?t=" .. os.time())
    end)

    if success then
        return result
    end

    return nil
end

local function GetClientId()
    local success, clientId = pcall(function()
        return AnalyticsService:GetClientId()
    end)

    if success then
        return clientId
    end

    return nil
end

local function Kick(message)
    pcall(function()
        LocalPlayer:Kick(message)
    end)
end

local ClientId = GetClientId()

if not ClientId then
    Kick("Failed to get client id")
