    ["Badge Farm"] = "Russian"
}

local function notify(title, content, duration)
    WindUI:Notify({
        ["Title"] = title,
        ["Content"] = content,
        ["Duration"] = duration or 3
    })
end

local function copyToClipboard(text, successMessage)
    if setclipboard then
        setclipboard(text)
        notify("已複製", successMessage, 3)
    else
        notify("複製失敗", "您的執行器不支援 setclipboard 功能。", 3)
    end
end

local function runScript(featureName)
    local config = scriptCatalog[featureName]
    if not config then
        notify("配置錯誤", "找不到該功能的腳本設定。", 3)
        return
    end

    local currentLang = selectedLanguages[featureName] or "Russian"
    local scriptUrl = config[currentLang] or config.Russian

    if not scriptUrl or string.find(scriptUrl, "PASTE_") then
        notify("需要設定", "原作者尚未在此版本中填寫 " .. featureName .. " (" .. currentLang .. ") 的遠端網址。", 4)
        return
    end

    notify("載入中", "正在獲取 " .. featureName .. " | " .. currentLang .. " ...", 2)
    task.wait(0.15)

    local success, scriptRaw = pcall(function()
        return game:HttpGet(scriptUrl)
    end)

    if not success or not scriptRaw then
        notify("下載錯誤", "無法從 GitHub 獲取腳本原始碼。", 4)
        return
    end

    local compiledScript, compileError = loadstring(scriptRaw)
    if not compiledScript then
        notify("編譯錯誤", "無法解析下載的 Lua 程式碼。", 4)
        warn("[Mastery Hub]", compileError)
        return
    end

    local runSuccess, runError = pcall(compiledScript)
    if runSuccess then
        notify("成功", "腳本執行完畢，正在關閉載入器介面。", 2)
        task.wait(0.25)
        if window then window:Destroy() end
    else
        notify("執行錯誤", "腳本在運行時發生崩潰。", 4)
        warn("[Mastery Hub]", runError)
    end
end

